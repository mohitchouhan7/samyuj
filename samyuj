#!/usr/bin/env bash
set -euo pipefail
SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
if [ -d "${SCRIPT_DIR}/src/samyuj" ]; then
    export PYTHONPATH="${SCRIPT_DIR}/src${PYTHONPATH:+:$PYTHONPATH}"
elif [ -d "/usr/lib/samyuj/src/samyuj" ]; then
    export PYTHONPATH="/usr/lib/samyuj/src${PYTHONPATH:+:$PYTHONPATH}"
fi
if [ -x "${SCRIPT_DIR}/.venv/bin/python3" ]; then
    exec "${SCRIPT_DIR}/.venv/bin/python3" -m samyuj "$@"
fi
exec python3 -m samyuj "$@"
